# tmux 的 -F 格式串。用 \t 分隔，名字里就算有空格也不会串列。
_WIN_FMT = "\t".join([
    "#{session_name}", "#{window_index}", "#{window_name}", "#{window_active}",
    "#{pane_current_command}", "#{pane_dead}", "#{window_activity}",
    "#{window_id}",
])


def tmux_sessions():
    """-> [(会话名, 窗口数, 创建时间, 是否attached)]；没 server 就返回 []。"""
    tmux = shutil.which("tmux")
    if not tmux:
        return []
    try:
        r = subprocess.run([tmux, "list-sessions", "-F",
                            "#{session_name}\t#{session_windows}\t"
                            "#{session_created}\t#{session_attached}"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return []
    if r.returncode != 0:
        return []                      # no server running 之类的，正常
    out = []
    for ln in r.stdout.splitlines():
        parts = ln.split("\t")
        if len(parts) >= 4:
            out.append(parts[:4])
    return out


def tmux_windows(session=None):
    """-> [{session,index,name,active,cmd,dead,activity}]"""
    tmux = shutil.which("tmux")
    if not tmux:
        return []
    target = session or ""
    cmd = [tmux, "list-windows"] + (["-t", target] if target else []) + ["-F", _WIN_FMT]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return []
    if r.returncode != 0:
        return []
    out = []
    for ln in r.stdout.splitlines():
        p_ = ln.split("\t")
        if len(p_) < 8:
            continue
        out.append({
            "session": p_[0], "index": p_[1], "name": p_[2],
            "active": p_[3] == "1", "cmd": p_[4],
            "dead": p_[5] == "1", "activity": p_[6], "wid": p_[7],
        })
    return out


def current_tmux_window():
    """我正待着的那个窗口的 id；不在 tmux 里返回 None。"""
    if not os.environ.get("TMUX"):
        return None
    tmux = shutil.which("tmux")
    if not tmux:
        return None
    try:
        r = subprocess.run([tmux, "display-message", "-p", "#{window_id}"],
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


