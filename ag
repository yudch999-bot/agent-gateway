# ---------------------------------------------------------------- 会话历史
#
# 各家的会话文件格式完全不同、还会变（claude 是
# ~/.claude/projects/<编码路径>/<uuid>.jsonl，codex 是
# ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl，……）。
# 所以这里**不做 per-agent 解析器**，只写一个宽容的通用提取器：
# 认得出就显示，认不出就少显示一点，绝不因为格式变了就整个崩掉。

def _walk_texts(node, depth=0, budget=None):
    """按顺序挖出节点里所有像人话的字符串。

    各家格式差别很大：claude 在 message.content[].text，
    codex 在 payload.content[].text，jcode 在 messages[].content[].text。
    与其给每家写解析器（格式一变就崩），不如按 key 名宽容地递归找。
    """
    if budget is None:
        budget = [60]
    if budget[0] <= 0 or depth > 4:
        return
    if isinstance(node, str):
        budget[0] -= 1
        yield node
        return
    if isinstance(node, list):
        for x in node[:20]:
            yield from _walk_texts(x, depth + 1, budget)
        return
    if not isinstance(node, dict):
        return
    # payload 是 codex 的外壳，得钻进去
    for key in ("payload", "title", "text", "content", "message",
                "messages", "summary"):
        if key in node and node[key] is not None:
            yield from _walk_texts(node[key], depth + 1, budget)


# 这些是 agent 自己塞进去的元信息，不是人说的话
_NOISE = ("Below is a conversation log", "<command-name>", "<local-command",
          "<system-reminder>", "Caveat:", "You are a", "# AGENTS.md",
          "Session Context", "<user_info>", "<env>", "<task-notification>",
          "<output-file>", "<tool-use", "<function_calls>",
          "Response MUST", "You MUST", "<instructions>", "Always respond")


def _prose(s):
    """像人话吗？用来把终端输出、工具结果、XML 标签挡在外面。

    判据故意粗糙但有效：别以 < 或 shell 提示符开头，别全是符号，
    长度在合理区间，字母/汉字占比够高。
    """
    if not s or len(s) < 8:
        return None
    t = " ".join(s.split())
    if len(t) > 400:
        t = t[:400]
    if t.startswith(("<", ">", "$", "%", "│", "┃", "╭", "╰", "```")):
        return None
    if any(n in t for n in _NOISE):
        return None
    good = sum(1 for ch in t if ch.isalnum() or ch.isspace()
               or "\u4e00" <= ch <= "\u9fff")
    if good / max(1, len(t)) < 0.72:
        return None            # 符号太多，多半是表格/日志/代码
    # 「🚀 ~ % openclaw update」这类 shell 回显
    if t.count("%") + t.count("│") + t.count("◇") >= 1:
        return None
    return t


def _prose_in(node):
    """从节点里挑第一段像人话的文本。"""
    for cand in _walk_texts(node):
        got = _prose(cand)
        if got:
            return got
    return None


def _user_text(d):
    """优先取「用户说的话」，各家的位置不一样。"""
    if str(d.get("type", "")).lower() == "user":
        got = _prose_in(d.get("message") or d)
        if got:
            return got
    m = d.get("message")
    if isinstance(m, dict) and m.get("role") == "user":
        got = _prose_in(m)
        if got:
            return got
    pay = d.get("payload")
    if isinstance(pay, dict) and pay.get("role") == "user":
        got = _prose_in(pay)
        if got:
            return got
    msgs = d.get("messages")           # jcode 这种整份塞一行里的
    if isinstance(msgs, list):
        for m in msgs[:12]:
            if isinstance(m, dict) and m.get("role") == "user":
                got = _prose_in(m)
                if got:
                    return got
    return None

_CWD_KEYS = ("cwd", "working_dir", "workdir", "project_dir", "projectPath")


def _first_cwd(node, depth=0):
    if depth > 3 or not isinstance(node, dict):
        return None
    for k in _CWD_KEYS:
        v = node.get(k)
        if isinstance(v, str) and v.startswith("/"):
            return v
    for k in ("payload", "session_meta", "meta", "context"):
        got = _first_cwd(node.get(k), depth + 1)
        if got:
            return got
    return None


_CWD_TAG = re.compile(r"<cwd>\s*([^<\s]+)\s*</cwd>")


def _cwd_from_text(node):
    """有的格式不存 cwd，只把环境上下文当文本塞进来。从 <cwd> 标签里捞。"""
    for cand in _walk_texts(node):
        m = _CWD_TAG.search(cand)
        if m and m.group(1).startswith("/"):
            return m.group(1)
    return None


def session_meta(path, max_lines=300):
    """通用会话元信息提取：cwd / 标题 / 时间。

    认不出就返回 None，调用方自己决定怎么显示 —— 绝不因为某家格式变了整个崩掉。
    """
    cwd = title = ts = None
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f):
                if i >= max_lines:
                    break
                line = line.strip()
                if not line or '"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue          # 半截行、二进制行，跳过
                if not isinstance(d, dict):
                    continue
                pay = d.get("payload") if isinstance(d.get("payload"), dict) else {}
                cwd = (cwd or _first_cwd(d) or _first_cwd(pay)
                       or _cwd_from_text(d))
                ts = ts or d.get("timestamp") or pay.get("timestamp") \
                    or d.get("startTime") or d.get("created_at")
                if title is None:
                    title = _user_text(d) or _prose_in(d)
                if cwd and title and ts:
                    break
    except OSError:
        return {"cwd": None, "title": None, "ts": None, "error": True}
    return {"cwd": cwd, "title": title, "ts": ts}


# 子会话 / 派生会话：主会话里派出去的小任务，手交接下来没意义
_SUB_MARKERS = ("/subagents/", "/sidechain", "/compact", "/tasks/", "/.work-graph")


def session_files(e):
    """某个 agent 的会话文件列表。"""
    if not e.sessions:
        return []
    root = os.path.expanduser(e.sessions)
    if not os.path.isdir(root):
        return []
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for fn in filenames:
            if not fn.endswith((".jsonl", ".json")):
                continue
            full = os.path.join(dirpath, fn)
            if any(m in full for m in _SUB_MARKERS):
                continue
            out.append(full)
    return out


def grep_sessions(paths, keyword):
    """返回命中的文件集合。优先用 ripgrep（1.8G 历史也就一两秒）。"""
    if not paths:
        return set()
    if shutil.which("rg"):
        try:
            r = subprocess.run(
                ["rg", "-l", "-i", "-F", "--no-messages", "--", keyword, *paths],
                capture_output=True, text=True, timeout=120)
            return {ln for ln in r.stdout.splitlines() if ln}
        except (OSError, subprocess.SubprocessError):
            pass
    # 没有 rg 就退回 Python，但只扫尾部若干字节，避免读爆
    hits = set()
    needle = keyword.lower().encode()
    for p in paths:
        try:
            size = os.path.getsize(p)
            with open(p, "rb") as f:
                if size > 2_000_000:
                    f.seek(-2_000_000, os.SEEK_END)
                if needle in f.read().lower():
                    hits.add(p)
        except OSError:
            continue
    return hits


def fmt_session_time(ts):
    """会话里的 ISO 时间戳 -> 「3 天前」。认不出就返回 ''。"""
    if not ts:
        return ""
    try:
        s = str(ts).replace("Z", "+00:00")
        t = time.mktime(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, TypeError):
        return ""
    return human_age(t)


def short_cwd(cwd):
    if not cwd:
        return "?"
    c = str(cwd)
    if c.startswith(HOME):
        c = "~" + c[len(HOME):]
    return c


def cmd_search(entries, args):
    """在历史会话里搜关键词。"""
    kw = " ".join(a for a in args if not a.startswith("-"))
    if not kw:
        return die("用法：ag search <关键词>")
    limit = 20
    for a in args:
        if a.startswith("--limit="):
            try:
                limit = int(a.split("=", 1)[1])
            except ValueError:
                pass

    roots = [e for e in entries if e.sessions and not e.hidden]
    if not roots:
        return die("没有任何 agent 登记了 sessions 目录（见 ag edit）")

    print(f"\n  {C['gry']}搜索 {len(roots)} 个 agent 的历史会话："
          f"{kw!r}{C['r']}")
    all_hits = []
    for e in roots:
        files = session_files(e)
        if not files:
            continue
        hits = grep_sessions(files, kw)
        for h in hits:
            all_hits.append((os.path.getmtime(h), e, h))
        if hits:
            print(f"    {C['b']}{pad(e.id, 12)}{C['r']} "
                  f"{C['grn']}{len(hits)}{C['r']} {C['gry']}/{len(files)} 个会话命中{C['r']}")

    if not all_hits:
        print(f"\n  {C['yel']}没搜到。{C['r']}"
              f"{C['gry']}换个关键词试试，或者那个 agent 还没登记 sessions{C['r']}\n")
        return 0

    all_hits.sort(reverse=True, key=lambda t: t[0])
    print(f"\n  {C['b']}命中 {len(all_hits)} 个会话"
          f"{f'，显示最近 {limit} 个' if len(all_hits) > limit else ''}：{C['r']}\n")
    for _, e, path in all_hits[:limit]:
        meta = session_meta(path, max_lines=120)
        when = fmt_session_time(meta.get("ts")) or human_age(os.path.getmtime(path))
        print(f"  {C['b']}{pad(e.id, 10)}{C['r']} "
              f"{C['gry']}{when:>10}{C['r']}  "
              f"{C['cyn']}{trunc(short_cwd(meta.get('cwd')), 34)}{C['r']}")
        if meta.get("title"):
            print(f"            {C['gry']}{trunc(meta['title'], 78)}{C['r']}")
        print(f"            {C['gry']}{trunc(short_home(path), 78)}{C['r']}")
    print(f"\n  {C['gry']}想接着聊：{C['cyn']}ag resume <id>{C['r']}"
          f"{C['gry']}（会话选择器里挑对应那条）{C['r']}\n")
    return 0


def short_home(p):
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


