def cmd_scan(entries, args):
    registered = set()
    for e in entries:
        registered.add(e.cmd)
        for a in e.all_ids:
            registered.add(a)
    found = []
    seen = set()
    for name in KNOWN_AGENTS:
        if name in seen or name in registered:
            continue
        p = shutil.which(name)
        if p:
            seen.add(name)
            found.append((name, p))
    if not found:
        print(f"  {C['grn']}✓ 没有发现未登记的 agent{C['r']}")
        return 0
    print(f"\n  {C['b']}发现 {len(found)} 个已安装但没登记的 agent：{C['r']}\n")
    for name, p in found:
        print(f"  {C['grn']}+{C['r']} {C['b']}{pad(name, 16)}{C['r']} {C['gry']}{p}{C['r']}")
    print(f"\n  {C['gry']}登记它：  ag add --id {found[0][0]} --cmd {found[0][1]}{C['r']}\n")
    return 0


def cmd_doctor(entries, args):
    print(f"\n  {C['b']}ag doctor{C['r']}  {C['gry']}注册表：{REGISTRY}{C['r']}\n")
    bad = 0
    for e in entries:
        p = e.resolved()
        if p:
            extra = "" if os.path.realpath(p).startswith(HOME) else f"  {C['yel']}(系统目录){C['r']}"
            print(f"  {C['grn']}●{C['r']} {C['b']}{pad(e.id, 16)}{C['r']} {C['gry']}{p}{C['r']}{extra}")
        else:
            bad += 1
            print(f"  {C['red']}○{C['r']} {C['b']}{pad(e.id, 16)}{C['r']} {C['red']}未安装{C['r']} "
                  f"{C['gry']}{e.install or 'cmd=' + e.cmd}{C['r']}")
    print(f"\n  {C['gry']}{len(entries) - bad}/{len(entries)} 可用。"
          f"装缺失的：  ag install <id>   或   ag install --missing{C['r']}\n")
    return 0


def cmd_install(entries, args):
    if not args:
        return die("用法：ag install <id> | ag install --missing")
    if args[0] == "--missing":
        todo = [e for e in entries if not e.resolved() and e.install]
        if not todo:
            print(f"  {C['grn']}✓ 没有缺失的{C['r']}")
            return 0
        for e in todo:
            print(f"\n  {C['b']}安装 {e.id}{C['r']}  {C['gry']}{e.install}{C['r']}")
            subprocess.run(e.install, shell=True)
        return 0
    e = find_entry(entries, args[0])
    if not e:
        return die(f"注册表里没有 「{args[0]}」")
    if not e.install:
        return die(f"「{e.id}」没有登记 install 命令，用 ag edit 补上")
    print(f"  {C['b']}安装 {e.id}{C['r']}  {C['gry']}{e.install}{C['r']}\n")
    rc = subprocess.run(e.install, shell=True).returncode
    print(f"\n  {'✓ 完成' if rc == 0 else '✗ 失败 rc=' + str(rc)}")
    return rc


def cmd_edit(entries, args):
    ed = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nano"
    return subprocess.run([ed, REGISTRY]).returncode


