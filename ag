# ---------------------------------------------------------------- main

def main(argv):
    if not os.path.exists(REGISTRY):
        os.makedirs(AG_DIR, exist_ok=True)
        open(REGISTRY, "w").write("# ag registry\n")

    entries = load_registry()
    a = argv[1:]

    if a and a[0] in ("-h", "--help", "help"):
        return usage()
    if a and a[0] in ("-v", "--version"):
        print(f"ag {VERSION}")
        return 0
    if a and a[0] == "path":
        print(REGISTRY)
        return 0

    sub = {"ls": cmd_ls, "list": cmd_ls, "add": cmd_add, "rm": cmd_rm,
           "remove": cmd_rm, "edit": cmd_edit, "scan": cmd_scan,
           "doctor": cmd_doctor, "install": cmd_install, "which": cmd_which,
           "resume": cmd_resume, "r": cmd_resume,
           "last": cmd_last, "l": cmd_last,
           "pin": cmd_pin, "unpin": lambda es, ar: cmd_pin(es, ar, remove=True),
           "stats": cmd_stats,
           "update": cmd_update, "upgrade": cmd_update, "up": cmd_update,
           "outdated": cmd_outdated, "old": cmd_outdated,
           "search": cmd_search, "find": cmd_search, "s": cmd_search,
           "handoff": cmd_handoff, "ho": cmd_handoff}

    if a and a[0] in sub:
        return sub[a[0]](entries, a[1:])

    if not entries:
        return die(f"注册表是空的：{REGISTRY}")

    # 无参数 → 选择器
    if not a:
        if not sys.stdin.isatty():
            return cmd_ls(entries, [])
        e, action = picker(entries)
        if e is None:
            return 0
        return cmd_launch(e, [], resume=(action == "resume"))

    # 有参数 → 先精确匹配 id/alias
    e = find_entry(entries, a[0])
    if e:
        return cmd_launch(e, a[1:])

    # 不精确 → 唯一模糊匹配就直接启动，否则开预筛选选择器
    hits = fuzzy([x for x in entries if not x.hidden], a[0])
    if len(hits) == 1:
        return cmd_launch(hits[0][0], a[1:])
    if not sys.stdin.isatty():
        return die(f"没有 「{a[0]}」，候选：" +
                   ", ".join(x.id for x, _ in hits[:8]) if hits else f"没有 「{a[0]}」")
    e, action = picker(entries, initial=a[0], prompt=f"筛选「{a[0]}」")
    if e is None:
        return 0
    return cmd_launch(e, [], resume=(action == "resume"))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
