def cmd_team(entries, args):
    """一次开多个 agent，各占一个窗口。

        ag team                  打开多选器（Tab 勾选）
        ag team cc oc goose      直接指定几个
        ag team --panes cc oc    用分屏而不是分窗口
        ag team -r cc oc         都续聊上次的会话
    """
    layout = "panes" if "--panes" in args else "windows"
    resume = "-r" in args or "--resume" in args
    session = None
    for a in args:
        if a.startswith("--session="):
            session = a.split("=", 1)[1]
    ids = [a for a in args if not a.startswith("-")]

    if ids:
        picked = []
        for a in ids:
            e = find_entry(entries, a)
            if not e:
                return die(f"注册表里没有 「{a}」")
            picked.append(e)
    else:
        if not sys.stdin.isatty():
            return die("用法：ag team <id> [id...]（非交互环境必须写全）")
        picked, _ = picker(entries, prompt="多选（Tab 勾选，Enter 一次全开）")
        if not picked:
            print(f"  {C['gry']}没选，退出{C['r']}")
            return 0

    if "--dry-run" in args or "-n" in args:
        sess = session or "ag"
        print(f"\n  {C['b']}将开 {len(picked)} 个 tmux "
              f"{'分屏' if layout == 'panes' else '窗口'}{C['r']}"
              f"  {C['gry']}(--dry-run，没真跑){C['r']}\n")
        for argv, e in build_tmux_plan(picked, sess, layout, resume, fresh=True):
            if e is None:
                print(f"    {C['gry']}{shlex.join(argv)}{C['r']}")
            else:
                print(f"    {C['b']}{pad(e.id, 12)}{C['r']} "
                      f"{C['cyn']}{argv[-1]}{C['r']}")
        print()
        return 0

    missing = [e.id for e in picked if not e.resolved()]
    if missing:
        print(f"  {C['yel']}!{C['r']} 这几个没装，会开个空窗口：{', '.join(missing)}")

    if len(picked) == 1 and not ids:
        return cmd_launch(picked[0], [], resume=resume)
    return launch_many(picked, layout=layout, resume=resume, session=session)


