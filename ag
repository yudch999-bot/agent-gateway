def cmd_resume(entries, args):
    """续聊：接着上次那个会话继续。

    各家 agent 的续聊方式不一样（claude --resume / codex resume / ...），
    这里不自己解析会话文件，只把命令转过去，让各家的选择器自己干活。
    """
    if args and not args[0].startswith("-"):
        e = find_entry(entries, args[0])
        if not e:
            return die(f"注册表里没有 「{args[0]}」")
        return cmd_launch(e, args[1:], resume=True)

    cands = [e for e in entries if e.can_resume and not e.hidden]
    if not cands:
        print(f"{C['yel']}没有任何 agent 登记了续聊方式。{C['r']}")
        print(f"  在注册表里给对应条目加一行就行：")
        print(f"    {C['cyn']}resume = [\"--resume\"]{C['r']}   "
              f"{C['gry']}# claude / grok 这种选项式{C['r']}")
        print(f"    {C['cyn']}resume = [\"resume\"]{C['r']}     "
              f"{C['gry']}# codex / goose 这种子命令式{C['r']}")
        return 1

    if not sys.stdin.isatty():
        # 非交互：退回「最近用过的那个」
        return cmd_last(entries, [])

    e, _ = picker(cands, prompt="续聊哪个？")
    if e is None:
        return 0
    return cmd_launch(e, args, resume=True)


def cmd_last(entries, args):
    """接着上次那个 agent 干。

        ag last          接上次的会话继续（没登记 resume 就开新会话）
        ag last --new    明确开新会话
    """
    extra = [a for a in args if a not in ("--new", "-n")]
    fresh = ("--new" in args) or ("-n" in args)

    usage = load_usage()
    lid = last_used_id()
    if not lid:
        return die("还没有使用记录。先跑一次 ag <id> 就有了")

    e = find_entry(entries, lid)
    if not e:
        return die(f"上次用的是 「{lid}」，但它已经不在注册表里了")

    stamps = usage.get(lid) or []
    when = human_age(stamps[-1]) if stamps else "?"
    what = "新会话" if (fresh or not e.can_resume) else "接着上次的会话"
    print(f"  {C['gry']}上次用的是 {C['b']}{e.id}{C['r']}{C['gry']}"
          f"（{when}，共 {len(stamps)} 次）→ {what}{C['r']}")

    return cmd_launch(e, extra, resume=not fresh)


