# ---------------------------------------------------------------- 数据模型

class Entry:
    __slots__ = ("id", "name", "cmd", "args", "desc", "tags", "alias", "env",
                 "cwd", "install", "update", "resume", "sessions", "hidden", "raw")

    def __init__(self, d: dict):
        self.raw = d
        self.id = str(d.get("id", "")).strip()
        self.name = str(d.get("name", self.id)).strip()
        self.cmd = str(d.get("cmd", "")).strip()
        self.args = [str(a) for a in d.get("args", [])]
        self.desc = str(d.get("desc", "")).strip()
        self.tags = [str(t) for t in d.get("tags", [])]
        self.alias = [str(a) for a in d.get("alias", [])]
        self.env = {str(k): str(v) for k, v in d.get("env", {}).items()}
        self.cwd = str(d.get("cwd", "")).strip()
        self.install = str(d.get("install", "")).strip()
        self.update = str(d.get("update", "")).strip()
        # resume 是「继续上次会话」的参数，比如 ["--resume"]、["resume"]。
        # 缺省不填就表示这个 agent 不支持续聊，ag resume 会明确告诉你。
        self.resume = [str(a) for a in d.get("resume", [])]
        # 会话历史目录，给 ag search / ag handoff 用。
        # 各家格式私有，所以这里只记「去哪找」，解析交给下面的通用提取器。
        self.sessions = str(d.get("sessions", "")).strip()
        self.hidden = bool(d.get("hidden", False))

    @property
    def all_ids(self):
        return [self.id] + self.alias

    @property
    def can_resume(self):
        return bool(self.resume)

    def haystack(self) -> str:
        return " ".join([self.id, self.name, self.desc, self.cmd,
                         " ".join(self.tags), " ".join(self.alias)]).lower()

    def resolved(self):
        """返回可执行文件绝对路径，找不到返回 None。"""
        if not self.cmd:
            return None
        if "/" in self.cmd:
            p = os.path.expanduser(self.cmd)
            return p if os.access(p, os.X_OK) else None
        return shutil.which(self.cmd)

    def argv(self, extra=None):
        return [self.cmd, *self.args, *(extra or [])]

    def resume_argv(self, extra=None):
        return [self.cmd, *self.args, *self.resume, *(extra or [])]

    def config_dir(self):
        """猜这个 agent 的配置目录，给 Ctrl-O 用。"""
        home = os.path.expanduser("~")
        for name in (self.id, self.cmd.split("/")[-1], *self.alias):
            for cand in (os.path.join(home, "." + name),
                         os.path.join(home, ".config", name)):
                if os.path.isdir(cand):
                    return cand
        return None


def load_registry(path=None):
    # 注意别写成 path=REGISTRY：默认参数在「函数定义时」就绑定死了，
    # 之后改 ag.REGISTRY（比如测试里指向临时文件）它不会跟。
    path = path or REGISTRY
    if not os.path.exists(path):
        return []
    with open(path, "rb") as f:
        data = tomllib.load(f)
    out = []
    for d in data.get("agent", []):
        e = Entry(d)
        if e.id and e.cmd:
            out.append(e)
    return out


def find_entry(entries, key):
    """精确匹配 id 或 alias。"""
    k = key.lower()
    for e in entries:
        if any(a.lower() == k for a in e.all_ids):
            return e
    return None


def fuzzy(entries, query):
    """返回 (entry, rank) 列表，按 rank 排序。空 query 返回全部。

    rank: 0 精确 id · 1 id 前缀 · 2 id 含 · 3 名字前缀 · 4 别名前缀
          5 主字段含 · 6 只在说明/标签里命中（沉底，但仍可搜到）
    """
    q = query.strip().lower()
    if not q:
        return [(e, 0) for e in entries]
    tokens = q.split()
    hits = []
    for e in entries:
        hay = e.haystack()
        if not all(t in hay for t in tokens):
            continue
        primary = " ".join([e.id, e.name, *e.alias]).lower()
        i = e.id.lower()
        if i == q:
            rank = 0
        elif i.startswith(q):
            rank = 1
        elif q in i:
            rank = 2
        elif e.name.lower().startswith(q):
            rank = 3
        elif any(a.lower().startswith(q) for a in e.all_ids):
            rank = 4
        elif all(t in primary for t in tokens):
            rank = 5
        else:
            rank = 6
        hits.append((e, rank))
    hits.sort(key=lambda t: (t[1], len(t[0].id), t[0].id))
    return hits


# ---------------------------------------------------------------- 使用记录
#
# usage.jsonl 一行一条：{"t": 1759250000, "id": "cc", "cwd": "/Users/..."}
# 追加写、不锁、坏行直接跳过 —— 崩了最多丢一条记录，不值得为它做事务。

def record_use(entry_id, cwd=None, resumed=False):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(USAGE, "a", encoding="utf-8") as f:
            f.write(json.dumps({
                "t": int(time.time()),
                "id": entry_id,
                "cwd": cwd or os.getcwd(),
                "resumed": bool(resumed),
            }, ensure_ascii=False) + "\n")
    except OSError:
        pass          # 记不上就算了，绝不能让记录失败挡住启动
    _trim_usage()


def _trim_usage():
    """日志太长就砍掉最老的一半，避免无限长。"""
    try:
        if os.path.getsize(USAGE) < 2_000_000:
            return
        with open(USAGE, encoding="utf-8") as f:
            lines = f.readlines()
        if len(lines) <= USAGE_MAX_LINES:
            return
        with open(USAGE, "w", encoding="utf-8") as f:
            f.writelines(lines[len(lines) // 2:])
    except OSError:
        pass


def load_usage_seq():
    """按写入顺序返回事件列表。坏行跳过。

    顺序很要紧：同一秒内连开两个 agent 时间戳会一样，
    光靠时间戳排不出先后，「最近用过的」得看谁写在后面。
    """
    out = []
    if not os.path.exists(USAGE):
        return out
    try:
        with open(USAGE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    r = json.loads(line)
                    out.append({"t": int(r["t"]), "id": str(r["id"]),
                                "cwd": str(r.get("cwd", "")),
                                "resumed": bool(r.get("resumed"))})
                except (ValueError, KeyError, TypeError):
                    continue
    except OSError:
        return []
    return out


def load_usage():
    """-> {id: [时间戳, ...]}，按时间升序。"""
    out = {}
    for ev in load_usage_seq():
        out.setdefault(ev["id"], []).append(ev["t"])
    return out


def frecency(usage, now=None):
    """每个 agent 一个分数：每次使用 +1，按 14 天半衰期衰减。

    用的多 + 最近用过 → 分高。偶尔翻出来用一次的老古董会自然沉下去。
    """
    now = now or time.time()
    out = {}
    for eid, stamps in usage.items():
        s = 0.0
        for t in stamps:
            age_days = max(0.0, (now - t) / 86400.0)
            s += 0.5 ** (age_days / HALF_LIFE_DAYS)
        out[eid] = s
    return out


def last_used_id():
    """最近一次用的是哪个 —— 直接取最后一条记录，不看时间戳（同秒会撞车）。"""
    seq = load_usage_seq()
    return seq[-1]["id"] if seq else None


# ---------------------------------------------------------------- 置顶

def load_pins():
    if not os.path.exists(PINS):
        return []
    try:
        with open(PINS, encoding="utf-8") as f:
            data = json.load(f)
        return [str(x) for x in data] if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_pins(pins):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = PINS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(sorted(set(pins)), f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, PINS)


def order_hits(hits, usage, pins, query="", entries=None):
    """给 fuzzy() 的结果排序：命中质量 > 置顶 > frecency > 短名长度。

    空查询时没有「命中质量」可言，就纯按 置顶 > frecency > 注册表原顺序。
    """
    frec = frecency(usage)
    pin_set = set(pins)
    reg_order = {e.id: i for i, e in enumerate(entries or [])}
    if not query.strip():
        return sorted(
            hits,
            key=lambda t: (t[0].id not in pin_set,
                           -frec.get(t[0].id, 0.0),
                           reg_order.get(t[0].id, 999)),
        )
    return sorted(
        hits,
        key=lambda t: (t[1],
                       t[0].id not in pin_set,
                       -frec.get(t[0].id, 0.0),
                       len(t[0].id),
                       t[0].id),
    )


def human_age(ts, now=None):
    """时间戳 -> 「刚刚 / 3 小时前 / 5 天前」。"""
    now = now or time.time()
    d = max(0, int(now - ts))
    if d < 60:
        return "刚刚"
    if d < 3600:
        return f"{d // 60} 分钟前"
    if d < 86400:
        return f"{d // 3600} 小时前"
    if d < 86400 * 30:
        return f"{d // 86400} 天前"
    return f"{d // 86400 // 30} 个月前"


# ---------------------------------------------------------------- 工具

def term_width(default=100):
    try:
        return shutil.get_terminal_size((default, 24)).columns
    except Exception:
        return default


def vis_len(s):
    """粗略可见宽度（中文算 2）。"""
    import unicodedata
    n = 0
    for ch in s:
        n += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return n


def pad(s, width):
    n = vis_len(s)
    return s + " " * max(0, width - n)


def trunc(s, width):
    if vis_len(s) <= width:
        return s
    out, n = "", 0
    for ch in s:
        w = 2 if ord(ch) > 0x2E80 else 1
        if n + w > width - 1:
            return out + "…"
        out += ch
        n += w
    return out


def die(msg, code=1):
    print(f"{C['red']}✗{C['r']} {msg}", file=sys.stderr)
    return code


# ---------------------------------------------------------------- 启动

def cmd_launch(e: Entry, extra, resume=False):
    path = e.resolved()
    if not path:
        print(f"{C['red']}✗ 找不到可执行文件 「{e.cmd}」{C['r']}")
        if e.install:
            print(f"  装一下：  {C['cyn']}{e.install}{C['r']}")
        else:
            print(f"  用 {C['cyn']}ag edit{C['r']} 检查 registry.toml 里的 cmd 字段")
        return 127

    if resume and not e.can_resume:
        print(f"{C['yel']}!{C['r']} {C['b']}{e.id}{C['r']} 没登记续聊方式，"
              f"这次按新会话启动")
        print(f"  {C['gry']}想支持的话在注册表里加一行，例如：  "
              f"resume = [\"--resume\"]{C['r']}")
        resume = False

    if e.cwd:
        target = os.path.expanduser(e.cwd)
        if os.path.isdir(target):
            os.chdir(target)
        else:
            print(f"{C['yel']}! 工作目录不存在，保持当前目录：{target}{C['r']}")

    env = os.environ.copy()
    env.update(e.env)
    argv = e.resume_argv(extra) if resume else e.argv(extra)

    # 先记账再 exec —— execvpe 一调用这个进程就没了，之后写不了
    try:
        record_use(e.id, os.getcwd(), resumed=resume)
    except Exception:
        pass

    tag = f" {C['mag']}↻ 续聊{C['r']}" if resume else ""
    print(f"{C['grn']}▶{C['r']} {C['b']}{e.name}{C['r']} "
          f"{C['gry']}({e.id}){C['r']}{tag}  {C['dim']}{' '.join(argv)}{C['r']}")
    sys.stdout.flush()

    try:
        os.execvpe(e.cmd, argv, env)
    except FileNotFoundError:
        return die(f"启动失败：{e.cmd} 不在 PATH 上")
    except PermissionError:
        return die(f"启动失败：{path} 没有执行权限")
    except OSError as ex:
        return die(f"启动失败：{ex}")


# ---------------------------------------------------------------- 模糊选择器

def picker(entries, initial="", prompt="选一个 agent"):
    """全屏模糊选择器。

    返回 (Entry, action)：
        action = "run"     普通启动
                 "resume"  续聊（Ctrl-R）
    取消返回 (None, None)。
    """
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return None, None

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)

    def restore():
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1049l")   # 退出备用屏幕
        sys.stdout.write("\033[?25h")     # 显示光标
        sys.stdout.flush()

    def enter_alt():
        tty.setraw(fd)
        sys.stdout.write("\033[?1049h\033[?25l")
        sys.stdout.flush()

    def leave_alt():
        """临时回到普通屏幕跑外部命令（比如 open）。"""
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

    def read_key():
        b = os.read(fd, 1)
        if not b:
            return "EOF"
        if b == b"\x1b":
            r, _, _ = select.select([fd], [], [], 0.03)
            if not r:
                return "ESC"
            seq = os.read(fd, 1)
            if seq in (b"[", b"O"):
                while True:
                    r, _, _ = select.select([fd], [], [], 0.03)
                    if not r:
                        break
                    c = os.read(fd, 1)
                    if not c:          # 终端没了，别转圈
                        return "EOF"
                    seq += c
                    if c.isalpha() or c == b"~":
                        break
                return {b"[A": "UP", b"[B": "DOWN", b"[H": "HOME",
                        b"[F": "END", b"[5~": "PGUP", b"[6~": "PGDN"}.get(seq, "UNK")
            return "ESC"
        if b in (b"\r", b"\n"):
            return "ENTER"
        if b in (b"\x7f", b"\x08"):
            return "BACKSPACE"
        if b == b"\x03":
            return "ESC"
        if b == b"\x12":
            return "RESUME"
        if b == b"\x0f":
            return "CONFIG"
        if b == b"\x14":
            return "PIN"
        if b == b"\x15":
            return "CLEAR"
        if b == b"\x10":
            return "UP"
        if b == b"\x0e":
            return "DOWN"
        # UTF-8 多字节
        if b[0] >= 0x80:
            need = 2 if b[0] >> 5 == 0b110 else 3 if b[0] >> 4 == 0b1110 else 4
            buf = b
            while len(buf) < need:
                r, _, _ = select.select([fd], [], [], 0.05)
                if not r:
                    break
                buf += os.read(fd, 1)
            return buf.decode("utf-8", "ignore")
        return b.decode("utf-8", "ignore")

    query = initial
    cursor = 0
    visible = [e for e in entries if not e.hidden]
    usage = load_usage()
    pins = load_pins()
    show_help = False
    flash = ""
    W = term_width()

    idw = max([vis_len(e.id) for e in visible] + [2])
    namew = min(34, max([vis_len(e.name) for e in visible] + [4]))

    try:
        enter_alt()

        while True:
            hits = order_hits(fuzzy(visible, query), usage, pins,
                              query=query, entries=visible)
            items = [e for e, _ in hits]
            if cursor >= len(items):
                cursor = max(0, len(items) - 1)

            W = term_width()
            H = shutil.get_terminal_size((100, 24)).lines
            list_h = max(5, H - 6)
            top = max(0, min(cursor - list_h // 2, len(items) - list_h))

            out = ["\033[H\033[2J"]
            out.append(f"  {C['b']}{C['mag']}ag{C['r']} {C['dim']}Agent Gateway{C['r']}"
                       f"  {C['gry']}{len(items)}/{len(visible)} · {prompt}"
                       f" · 输入即筛选{C['r']}\r\n")

            if show_help:
                out.append(render_help(W))
                sys.stdout.write("".join(out))
                sys.stdout.flush()
                k = read_key()
                if k in ("ESC", "EOF", "?", "ENTER"):
                    show_help = False
                    continue
                if k in ("UP", "DOWN", "PGUP", "PGDN", "HOME", "END"):
                    continue
                if k == "BACKSPACE":
                    query = query[:-1]
                    cursor = 0
                    show_help = False
                    continue
                if k in ("CLEAR",):
                    query = ""
                    cursor = 0
                    show_help = False
                    continue
                show_help = False
                if k and k not in ("UNK",) and len(k) == 1:
                    query += k
                    cursor = 0
                elif k == "CONFIG":
                    pass
                continue

            out.append(f"  {C['cyn']}❯{C['r']} {C['b']}{query}{C['r']}"
                       f"\033[?25h\033[?25l\r\n")
            out.append(f"  {C['gry']}{'─' * min(W - 4, 96)}{C['r']}\r\n")

            if not items:
                out.append(f"\r\n  {C['yel']}没有匹配的 agent{C['r']}\r\n")

            pin_set = set(pins)
            for i in range(top, min(top + list_h, len(items))):
                e = items[i]
                ok = e.resolved() is not None
                pinned = e.id in pin_set
                idc = pad(e.id, idw)
                nmc = pad(trunc(e.name, namew), namew)
                dsc = trunc(e.desc, max(10, W - idw - namew - 14))
                # 选中行与非选中行前缀完全一致，只靠反显区分，避免左右跳动
                dot = "★" if pinned else ("●" if ok else "○")
                dotc = C['grn'] if ok else C['red']
                star = f"{C['mag']}↻{C['r']} " if e.can_resume else "  "
                if i == cursor:
                    line = (f"{C['inv']}  {dotc}{dot}{C['r']}"
                            f"{C['inv']} {C['b']}{idc}{C['r']}"
                            f"{C['inv']}  {nmc}  {C['gry']}{dsc}{C['r']}{C['inv']} {C['r']}")
                else:
                    line = (f"  {dotc}{dot}{C['r']} {C['b']}{idc}{C['r']}"
                            f"  {nmc}  {C['gry']}{dsc}{C['r']}")
                out.append(line + "\r\n")

            out.append(f"  {C['gry']}{'─' * min(W - 4, 96)}{C['r']}\r\n")

            # 详情行
            if items:
                e = items[cursor]
                bits = [f"{C['cyn']}{' '.join(e.argv())}{C['r']}"]
                stamps = usage.get(e.id) or []
                if stamps:
                    bits.append(f"{C['gry']}用过 {len(stamps)} 次 · "
                                f"{human_age(stamps[-1])}{C['r']}")
                if e.can_resume:
                    bits.append(f"{C['mag']}Ctrl-R 续聊{C['r']}")
                if e.tags:
                    bits.append(f"{C['gry']}tags: {','.join(e.tags)}{C['r']}")
                if not e.resolved() and e.install:
                    bits.append(f"{C['red']}未安装{C['r']}")
                out.append("  " + "  ".join(bits) + "\r\n")
            else:
                out.append("\r\n")

            if flash:
                out.append(f"  {C['yel']}{flash}{C['r']}\r\n")
                flash = ""
            else:
                out.append(f"  {C['gry']}↑↓ 移动 · Enter 启动 · Ctrl-R 续聊 · "
                           f"Ctrl-T 置顶 · Ctrl-O 配置 · ? 帮助 · Esc 退出{C['r']}\r\n")

            sys.stdout.write("".join(out))
            sys.stdout.flush()

            k = read_key()
            if k in ("ESC", "EOF"):
                return None, None
            if k == "ENTER":
                return (items[cursor], "run") if items else (None, None)
            if k == "RESUME":
                if not items:
                    continue
                e = items[cursor]
                if e.can_resume:
                    return e, "resume"
                flash = f"{e.id} 没登记续聊方式 —— 在注册表里加 resume = [...]"
            elif k == "PIN":
                if not items:
                    continue
                e = items[cursor]
                if e.id in pins:
                    pins.remove(e.id)
                    flash = f"已取消置顶 {e.id}"
                else:
                    pins.append(e.id)
                    flash = f"已置顶 {e.id}"
                save_pins(pins)
            elif k == "CONFIG":
                if not items:
                    continue
                e = items[cursor]
                d = e.config_dir()
                if not d:
                    flash = f"没找到 {e.id} 的配置目录"
                else:
                    leave_alt()
                    opener = (["open", d] if sys.platform == "darwin"
                              else ["xdg-open", d])
                    try:
                        subprocess.run(opener, check=False,
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
                    except OSError:
                        pass
                    enter_alt()
                    flash = f"已打开 {d}"
            elif k == "?":
                show_help = True
            elif k == "UP":
                cursor = max(0, cursor - 1)
            elif k == "DOWN":
                cursor = min(len(items) - 1, cursor + 1)
            elif k == "PGUP":
                cursor = max(0, cursor - list_h)
            elif k == "PGDN":
                cursor = min(max(0, len(items) - 1), cursor + list_h)
            elif k == "HOME":
                cursor = 0
            elif k == "END":
                cursor = max(0, len(items) - 1)
            elif k == "BACKSPACE":
                query = query[:-1]
                cursor = 0
            elif k == "CLEAR":
                query = ""
                cursor = 0
            elif len(k) == 1 or (k and k not in ("UNK",)):
                query += k
                cursor = 0
    finally:
        restore()


