# ---------------------------------------------------------------- 数据模型

class Entry:
    __slots__ = ("id", "name", "cmd", "args", "desc", "tags", "alias", "env",
                 "cwd", "install", "update", "resume", "sessions", "group",
                 "hidden", "raw")

    def __init__(self, d: dict):
        self.raw = d
        self.id = str(d.get("id", "")).strip()
        self.name = str(d.get("name", self.id)).strip()
        self.cmd = str(d.get("cmd", "")).strip()
        self.args = [str(a) for a in d.get("args", [])]
        self.desc = str(d.get("desc", "")).strip()
        self.tags = [str(t) for t in d.get("tags", [])]
        self.alias = [str(a) for a in d.get("alias", [])]
        self.env = {str(k): str(v) for k, v in d.get("env", {}).items()}
        self.cwd = str(d.get("cwd", "")).strip()
        self.install = str(d.get("install", "")).strip()
        self.update = str(d.get("update", "")).strip()
        # resume 是「继续上次会话」的参数，比如 ["--resume"]、["resume"]。
        # 缺省不填就表示这个 agent 不支持续聊，ag resume 会明确告诉你。
        self.resume = [str(a) for a in d.get("resume", [])]
        # 会话历史目录，给 ag search / ag handoff 用。
        # 各家格式私有，所以这里只记「去哪找」，解析交给下面的通用提取器。
        self.sessions = str(d.get("sessions", "")).strip()
        # 选择器里的分组标题。不填就归到「其它」，永远排在最后。
        self.group = str(d.get("group", "")).strip()
        self.hidden = bool(d.get("hidden", False))

    @property
    def all_ids(self):
        return [self.id] + self.alias

    @property
    def can_resume(self):
        return bool(self.resume)

    def haystack(self) -> str:
        return " ".join([self.id, self.name, self.desc, self.cmd,
                         " ".join(self.tags), " ".join(self.alias)]).lower()

    def resolved(self):
        """返回可执行文件绝对路径，找不到返回 None。"""
        if not self.cmd:
            return None
        if "/" in self.cmd:
            p = os.path.expanduser(self.cmd)
            return p if os.access(p, os.X_OK) else None
        return shutil.which(self.cmd)

    def argv(self, extra=None):
        return [self.cmd, *self.args, *(extra or [])]

    def resume_argv(self, extra=None):
        return [self.cmd, *self.args, *self.resume, *(extra or [])]

    def config_dir(self):
        """猜这个 agent 的配置目录，给 Ctrl-O 用。"""
        home = os.path.expanduser("~")
        for name in (self.id, self.cmd.split("/")[-1], *self.alias):
            for cand in (os.path.join(home, "." + name),
                         os.path.join(home, ".config", name)):
                if os.path.isdir(cand):
                    return cand
        return None


def load_registry(path=None):
    # 注意别写成 path=REGISTRY：默认参数在「函数定义时」就绑定死了，
    # 之后改 ag.REGISTRY（比如测试里指向临时文件）它不会跟。
    path = path or REGISTRY
    if not os.path.exists(path):
        return []
    with open(path, "rb") as f:
        data = tomllib.load(f)
    out = []
    for d in data.get("agent", []):
        e = Entry(d)
        if e.id and e.cmd:
            out.append(e)
    return out


def find_entry(entries, key):
    """精确匹配 id 或 alias。"""
    k = key.lower()
    for e in entries:
        if any(a.lower() == k for a in e.all_ids):
            return e
    return None


def fuzzy(entries, query):
    """返回 (entry, rank) 列表，按 rank 排序。空 query 返回全部。

    rank: 0 精确 id · 1 id 前缀 · 2 id 含 · 3 名字前缀 · 4 别名前缀
          5 主字段含 · 6 只在说明/标签里命中（沉底，但仍可搜到）
    """
    q = query.strip().lower()
    if not q:
        return [(e, 0) for e in entries]
    tokens = q.split()
    hits = []
    for e in entries:
        hay = e.haystack()
        if not all(t in hay for t in tokens):
            continue
        primary = " ".join([e.id, e.name, *e.alias]).lower()
        i = e.id.lower()
        if i == q:
            rank = 0
        elif i.startswith(q):
            rank = 1
        elif q in i:
            rank = 2
        elif e.name.lower().startswith(q):
            rank = 3
        elif any(a.lower().startswith(q) for a in e.all_ids):
            rank = 4
        elif all(t in primary for t in tokens):
            rank = 5
        else:
            rank = 6
        hits.append((e, rank))
    hits.sort(key=lambda t: (t[1], len(t[0].id), t[0].id))
    return hits


# ---------------------------------------------------------------- 使用记录
#
# usage.jsonl 一行一条：{"t": 1759250000, "id": "cc", "cwd": "/Users/..."}
# 追加写、不锁、坏行直接跳过 —— 崩了最多丢一条记录，不值得为它做事务。

def record_use(entry_id, cwd=None, resumed=False):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(USAGE, "a", encoding="utf-8") as f:
            f.write(json.dumps({
                "t": int(time.time()),
                "id": entry_id,
                "cwd": cwd or os.getcwd(),
                "resumed": bool(resumed),
            }, ensure_ascii=False) + "\n")
    except OSError:
        pass          # 记不上就算了，绝不能让记录失败挡住启动
    _trim_usage()


def _trim_usage():
    """日志太长就砍掉最老的一半，避免无限长。"""
    try:
        if os.path.getsize(USAGE) < 2_000_000:
            return
        with open(USAGE, encoding="utf-8") as f:
            lines = f.readlines()
        if len(lines) <= USAGE_MAX_LINES:
            return
        with open(USAGE, "w", encoding="utf-8") as f:
            f.writelines(lines[len(lines) // 2:])
    except OSError:
        pass


def load_usage_seq():
    """按写入顺序返回事件列表。坏行跳过。

    顺序很要紧：同一秒内连开两个 agent 时间戳会一样，
    光靠时间戳排不出先后，「最近用过的」得看谁写在后面。
    """
    out = []
    if not os.path.exists(USAGE):
        return out
    try:
        with open(USAGE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    r = json.loads(line)
                    out.append({"t": int(r["t"]), "id": str(r["id"]),
                                "cwd": str(r.get("cwd", "")),
                                "resumed": bool(r.get("resumed"))})
                except (ValueError, KeyError, TypeError):
                    continue
    except OSError:
        return []
    return out


def load_usage():
    """-> {id: [时间戳, ...]}，按时间升序。"""
    out = {}
    for ev in load_usage_seq():
        out.setdefault(ev["id"], []).append(ev["t"])
    return out


def frecency(usage, now=None):
    """每个 agent 一个分数：每次使用 +1，按 14 天半衰期衰减。

    用的多 + 最近用过 → 分高。偶尔翻出来用一次的老古董会自然沉下去。
    """
    now = now or time.time()
    out = {}
    for eid, stamps in usage.items():
        s = 0.0
        for t in stamps:
            age_days = max(0.0, (now - t) / 86400.0)
            s += 0.5 ** (age_days / HALF_LIFE_DAYS)
        out[eid] = s
    return out


def last_used_id():
    """最近一次用的是哪个 —— 直接取最后一条记录，不看时间戳（同秒会撞车）。"""
    seq = load_usage_seq()
    return seq[-1]["id"] if seq else None


# ---------------------------------------------------------------- 置顶

def load_pins():
    if not os.path.exists(PINS):
        return []
    try:
        with open(PINS, encoding="utf-8") as f:
            data = json.load(f)
        return [str(x) for x in data] if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_pins(pins):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = PINS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(sorted(set(pins)), f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, PINS)


def order_hits(hits, usage, pins, query="", entries=None):
    """给 fuzzy() 的结果排序：命中质量 > 置顶 > frecency > 短名长度。

    空查询时没有「命中质量」可言，就纯按 置顶 > frecency > 注册表原顺序。
    """
    frec = frecency(usage)
    pin_set = set(pins)
    reg_order = {e.id: i for i, e in enumerate(entries or [])}
    if not query.strip():
        return sorted(
            hits,
            key=lambda t: (t[0].id not in pin_set,
                           -frec.get(t[0].id, 0.0),
                           reg_order.get(t[0].id, 999)),
        )
    return sorted(
        hits,
        key=lambda t: (t[1],
                       t[0].id not in pin_set,
                       -frec.get(t[0].id, 0.0),
                       len(t[0].id),
                       t[0].id),
    )


OTHER_GROUP = "其它"


def parse_query(q):
    """把 '@openclaw ceo' 拆成 (组过滤, 剩余关键词)。没有 @ 就返回 (None, 原样)。"""
    q = (q or "").strip()
    if not q.startswith("@"):
        return None, q
    parts = q[1:].split(None, 1)
    return (parts[0].lower() if parts else ""), (parts[1] if len(parts) > 1 else "")


def grouped(items, usage, pins, entries=None):
    """-> [(组名, [条目...]), ...]

    组内排序：置顶 > 常用 > 注册表原顺序。
    组间排序：拿「该组第一位」的排序键比 —— 所以常用的组会浮上来，
    frecency 的好处没丢；一次没用过时就是注册表里那套逻辑顺序。
    「其它」永远垫底。
    """
    frec = frecency(usage)
    pin_set = set(pins)
    reg_order = {e.id: i for i, e in enumerate(entries or items)}
    buckets = {}
    for e in items:
        buckets.setdefault(e.group or OTHER_GROUP, []).append(e)

    def rank(e):
        # 最后那个 e.id 只是兜底的稳定排序，正常轮不到
        return (e.id not in pin_set, -frec.get(e.id, 0.0),
                reg_order.get(e.id, 9999), e.id)

    out = []
    for g, es in buckets.items():
        es.sort(key=rank)
        out.append((g, es, rank(es[0])))
    out.sort(key=lambda t: (t[0] == OTHER_GROUP, t[2]))
    return [(g, es) for g, es, _ in out]


def human_age(ts, now=None):
    """时间戳 -> 「刚刚 / 3 小时前 / 5 天前」。"""
    now = now or time.time()
    d = max(0, int(now - ts))
    if d < 60:
        return "刚刚"
    if d < 3600:
        return f"{d // 60} 分钟前"
    if d < 86400:
        return f"{d // 3600} 小时前"
    if d < 86400 * 30:
        return f"{d // 86400} 天前"
    return f"{d // 86400 // 30} 个月前"


# ---------------------------------------------------------------- 工具

def term_width(default=100):
    try:
        return shutil.get_terminal_size((default, 24)).columns
    except Exception:
        return default


def vis_len(s):
    """粗略可见宽度（中文算 2）。"""
    import unicodedata
    n = 0
    for ch in s:
        n += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return n


def pad(s, width):
    n = vis_len(s)
    return s + " " * max(0, width - n)


def trunc(s, width):
    if vis_len(s) <= width:
        return s
    out, n = "", 0
    for ch in s:
        w = 2 if ord(ch) > 0x2E80 else 1
        if n + w > width - 1:
            return out + "…"
        out += ch
        n += w
    return out


def die(msg, code=1):
    print(f"{C['red']}✗{C['r']} {msg}", file=sys.stderr)
    return code


# ---------------------------------------------------------------- 启动

def cmd_launch(e: Entry, extra, resume=False):
    path = e.resolved()
    if not path:
        print(f"{C['red']}✗ 找不到可执行文件 「{e.cmd}」{C['r']}")
        if e.install:
            print(f"  装一下：  {C['cyn']}{e.install}{C['r']}")
        else:
            print(f"  用 {C['cyn']}ag edit{C['r']} 检查 registry.toml 里的 cmd 字段")
        return 127

    if resume and not e.can_resume:
        print(f"{C['yel']}!{C['r']} {C['b']}{e.id}{C['r']} 没登记续聊方式，"
              f"这次按新会话启动")
        print(f"  {C['gry']}想支持的话在注册表里加一行，例如：  "
              f"resume = [\"--resume\"]{C['r']}")
        resume = False

    if e.cwd:
        target = os.path.expanduser(e.cwd)
        if os.path.isdir(target):
            os.chdir(target)
        else:
            print(f"{C['yel']}! 工作目录不存在，保持当前目录：{target}{C['r']}")

    env = os.environ.copy()
    env.update(e.env)
    argv = e.resume_argv(extra) if resume else e.argv(extra)

    # 先记账再 exec —— execvpe 一调用这个进程就没了，之后写不了
    try:
        record_use(e.id, os.getcwd(), resumed=resume)
    except Exception:
        pass

    tag = f" {C['mag']}↻ 续聊{C['r']}" if resume else ""
    print(f"{C['grn']}▶{C['r']} {C['b']}{e.name}{C['r']} "
          f"{C['gry']}({e.id}){C['r']}{tag}  {C['dim']}{' '.join(argv)}{C['r']}")
    sys.stdout.flush()

    try:
        os.execvpe(e.cmd, argv, env)
    except FileNotFoundError:
        return die(f"启动失败：{e.cmd} 不在 PATH 上")
    except PermissionError:
        return die(f"启动失败：{path} 没有执行权限")
    except OSError as ex:
        return die(f"启动失败：{ex}")


# ---------------------------------------------------------------- 一次开多个

def tmux_session_name():
    """当前 tmux 会话名；不在 tmux 里返回 None。"""
    if not os.environ.get("TMUX"):
        return None
    try:
        r = subprocess.run(["tmux", "display-message", "-p", "#S"],
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def session_exists(tmux, name):
    try:
        return subprocess.run([tmux, "has-session", "-t", name],
                              capture_output=True).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def terminal_fallback(entries, resume=False):
    """没有 tmux 时的退路：macOS 开 Terminal 窗口，其它平台就把命令打出来。"""
    if sys.platform == "darwin" and shutil.which("osascript"):
        for e in entries:
            argv = e.resume_argv() if resume else e.argv()
            cwd = os.path.expanduser(e.cwd) if e.cwd else os.getcwd()
            script = ('tell application "Terminal" to do script '
                      '"cd %s && %s"' % (cwd.replace('"', '\\"'),
                                         " ".join(argv).replace('"', '\\"')))
            subprocess.run(["osascript", "-e", script], check=False)
            record_use(e.id, cwd, resumed=resume)
            print(f"  {C['grn']}▶{C['r']} {C['b']}{e.name}{C['r']}"
                  f"  {C['gry']}新 Terminal 窗口{C['r']}")
        print(f"\n  {C['gry']}装个 tmux 会更好用：{C['cyn']}brew install tmux{C['r']}"
              f"{C['gry']}（多窗口、能挂后台、关了终端也不掉）{C['r']}\n")
        return 0

    print(f"\n  {C['yel']}没装 tmux，也开不了新终端窗口。{C['r']}"
          f"{C['gry']}手动开几个终端跑这些：{C['r']}\n")
    for e in entries:
        argv = e.resume_argv() if resume else e.argv()
        print(f"    {C['cyn']}{' '.join(argv)}{C['r']}")
    print(f"\n  {C['gry']}装 tmux 就能自动分好：{C['cyn']}brew install tmux{C['r']}\n")
    return 1


def build_tmux_plan(entries, sess, layout="windows", resume=False, fresh=True):
    """算出要跑哪些 tmux 命令。纯函数，不执行 —— 方便测。"""
    plan = []
    for i, e in enumerate(entries):
        argv = e.resume_argv() if resume else e.argv()
        cwd = os.path.expanduser(e.cwd) if e.cwd else os.getcwd()
        if not os.path.isdir(cwd):
            cwd = os.getcwd()
        if i == 0 and fresh:
            base = ["new-session", "-d", "-s", sess]
        elif layout == "panes":
            base = ["split-window", "-t", sess]
        else:
            base = ["new-window", "-t", sess]
        # 命令整条作为一个参数交给 tmux，它再过 shell —— 
        # 这样带空格的参数也不会散架，也不用纠结 tmux 的 -- 语义
        plan.append((["tmux", *base, "-n", e.id, "-c", cwd,
                      shlex.join(argv)], e))
    if layout == "panes":
        plan.append((["tmux", "select-layout", "-t", sess, "tiled"], None))
    return plan


def launch_many(entries, layout="windows", resume=False, session=None):
    """一次拉起多个 agent，每个占一个 tmux 窗口（或分屏）。

    在 tmux 里 → 往当前会话加窗口，人不用动
    不在 tmux 里 → 建一个会话再 attach 进去；关掉终端它们也还活着
    """
    tmux = shutil.which("tmux")
    if not tmux:
        return terminal_fallback(entries, resume)

    inside = tmux_session_name()
    sess = session or inside or "ag"
    fresh = not session_exists(tmux, sess)

    plan = build_tmux_plan(entries, sess, layout, resume, fresh)
    ran, failed, errs = [], [], []
    for argv, e in plan:
        try:
            # stderr 一定要收着 —— 不然 tmux 失败了用户完全看不出为什么
            r = subprocess.run(argv, check=False, capture_output=True, text=True)
            rc, err = r.returncode, (r.stderr or "").strip()
        except OSError as ex:
            rc, err = 1, str(ex)
        if e is None:
            continue
        if rc == 0:
            ran.append(e)
        else:
            failed.append(e)
            if err and err not in errs:
                errs.append(err)

    if not ran:
        print(f"  {C['red']}✗ tmux 一条命令都没跑成{C['r']}"
              f"  {C['gry']}（会话 {sess}）{C['r']}")
        for err in errs[:3]:
            print(f"    {C['red']}{trunc(err, 76)}{C['r']}")
        if any("fork failed" in e or "Operation not permitted" in e for e in errs):
            print(f"  {C['gry']}提示：这是权限/沙箱限制，不是 tmux 本身的问题。"
                  f"在真终端里跑就正常了{C['r']}")
        else:
            print(f"  {C['gry']}先确认 tmux 能用：{C['cyn']}tmux new -s test{C['r']}")
