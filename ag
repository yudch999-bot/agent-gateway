def cmd_add(entries, args):
    import argparse
    ap = argparse.ArgumentParser(prog="ag add", add_help=True)
    ap.add_argument("--id"); ap.add_argument("--name"); ap.add_argument("--cmd")
    ap.add_argument("--args", default=""); ap.add_argument("--desc", default="")
    ap.add_argument("--tags", default=""); ap.add_argument("--alias", default="")
    ap.add_argument("--cwd", default=""); ap.add_argument("--install", default="")
    ap.add_argument("--env", action="append", default=[])
    ns = ap.parse_args(args)

    data = {}
    if ns.id:
        data = dict(id=ns.id, name=ns.name or ns.id, cmd=ns.cmd or ns.id,
                    args=ns.args.split(), desc=ns.desc,
                    tags=[t for t in ns.tags.replace(",", " ").split() if t],
                    alias=[a for a in ns.alias.replace(",", " ").split() if a],
                    cwd=ns.cwd, install=ns.install,
                    env=dict(kv.split("=", 1) for kv in ns.env if "=" in kv))
    else:
        if not sys.stdin.isatty():
            return die("非交互环境请用：ag add --id X --cmd Y [...]")
        print(f"\n  {C['b']}添加新的 agent{C['r']}  {C['gry']}(回车用默认值，Ctrl-C 取消){C['r']}\n")

        def ask(label, default="", hint=""):
            tail = f" {C['gry']}[{default}]{C['r']}" if default else ""
            extra = f"  {C['gry']}{hint}{C['r']}" if hint else ""
            try:
                v = input(f"  {C['cyn']}{label}{C['r']}{tail}{extra}: ").strip()
            except EOFError:
                return default
            return v or default

        aid = ask("id（短名，如 cc）")
        if not aid:
            return die("id 不能为空")
        if find_entry(entries, aid):
            return die(f"「{aid}」已存在")
        data["id"] = aid
        data["name"] = ask("显示名", aid)
        data["cmd"] = ask("可执行文件", aid, "（名字或绝对路径）")
        data["args"] = ask("固定参数（空格分隔）", "").split()
        data["desc"] = ask("一句话说明", "")
        data["tags"] = [t for t in ask("标签（逗号或空格分隔）", "").replace(",", " ").split() if t]
        data["alias"] = [a for a in ask("额外别名", "").replace(",", " ").split() if a]
        data["install"] = ask("安装命令（可选）", "")
        data["cwd"] = ask("启动目录（可选）", "")

    e = Entry(data)
    if find_entry(entries, e.id):
        return die(f"「{e.id}」已存在，先 ag rm {e.id}")
    if not shutil.which(e.cmd) and not os.path.exists(os.path.expanduser(e.cmd)):
        print(f"  {C['yel']}! 警告：{e.cmd} 现在不在 PATH 上（先登记也行，装好了就能用）{C['r']}")

    with open(REGISTRY, "a", encoding="utf-8") as f:
        f.write("\n# ── 由 `ag add` 添加 ──\n" + render_toml(e))

    print(f"  {C['grn']}✓ 已添加{C['r']} {C['b']}{e.id}{C['r']} → {' '.join(e.argv())}")
    print(f"  {C['gry']}立刻可用： ag {e.id}{C['r']}\n")
    return 0


def toml_str(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def toml_arr(xs):
    return "[" + ", ".join(toml_str(x) for x in xs) + "]"


def render_toml(e: Entry):
    L = ["[[agent]]", f"id = {toml_str(e.id)}", f"name = {toml_str(e.name)}",
         f"cmd = {toml_str(e.cmd)}"]
    if e.args:
        L.append(f"args = {toml_arr(e.args)}")
    if e.desc:
        L.append(f"desc = {toml_str(e.desc)}")
    if e.tags:
        L.append(f"tags = {toml_arr(e.tags)}")
    if e.alias:
        L.append(f"alias = {toml_arr(e.alias)}")
    if e.cwd:
        L.append(f"cwd = {toml_str(e.cwd)}")
    if e.env:
        L.append("env = { " + ", ".join(f"{k} = {toml_str(v)}" for k, v in e.env.items()) + " }")
    if e.install:
        L.append(f"install = {toml_str(e.install)}")
    if e.update:
        L.append(f"update = {toml_str(e.update)}")
    if e.resume:
        L.append(f"resume = {toml_arr(e.resume)}")
    if e.hidden:
        L.append("hidden = true")
    return "\n".join(L) + "\n"


def backup_registry():
    """改注册表前先备份一份。"""
    import time
    d = os.path.join(os.path.dirname(REGISTRY), "backups")
    os.makedirs(d, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dst = os.path.join(d, f"registry.{stamp}.toml")
    shutil.copy2(REGISTRY, dst)
    # 只留最近 20 份
    olds = sorted(f for f in os.listdir(d) if f.startswith("registry."))
    for f in olds[:-20]:
        try:
            os.remove(os.path.join(d, f))
        except OSError:
            pass
    return dst


def cmd_rm(entries, args):
    """按 [[agent]] 块整块删除，保留文件里的注释和别人手写的格式。

    支持一次删多个：  ag rm hpw hpt hpc
    """
    if not args:
        return die("用法：ag rm <id> [id...]")

    targets, missing = [], []
    for a in args:
        e = find_entry(entries, a)
        if e is None:
            missing.append(a)
        elif e.id not in [t.id for t in targets]:
            targets.append(e)
    if missing:
        return die("注册表里没有：" + "、".join("「%s」" % m for m in missing))

    names = set()
    for t in targets:
        names.update(x.lower() for x in t.all_ids)

    with open(REGISTRY, encoding="utf-8") as f:
        lines = f.readlines()

    out, block, dropped = [], [], []

    def flush():
        if not block:
            return
        # 块尾的注释/空行其实是下一节的小标题，先摘出来，别跟着被删
        tail = []
        while len(block) > 1 and (not block[-1].strip()
                                  or block[-1].lstrip().startswith("#")):
            tail.insert(0, block.pop())
        hit = None
        for ln in block:
            s = ln.strip()
            if s.startswith("id") and "=" in s:
                val = s.split("=", 1)[1].strip().strip("\"\'")
                if val.lower() in names:
                    hit = val
            if s.startswith("alias") and "=" in s:
                for tok in s.split("=", 1)[1].strip().strip("[]").split(","):
                    if tok.strip().strip("\"\' ").lower() in names:
                        hit = hit or tok.strip().strip("\"\' ")
        if hit:
            dropped.append(hit)
        else:
            out.extend(block)
        out.extend(tail)

    for ln in lines:
        if ln.lstrip().startswith("[[agent]]"):
            flush()
            block = [ln]
        elif block:
            block.append(ln)
        else:
            out.append(ln)
    flush()

    if not dropped:
        return die("没找到对应的块，注册表可能被手改过；用 ag edit 看看")
    if not any(x.strip().startswith("[[agent]]") for x in out):
        out.append("\n# （空）用 `ag add` 加一个吧\n")

    bk = backup_registry()
    with open(REGISTRY, "w", encoding="utf-8") as f:
        f.writelines(out)

    print(f"  {C['grn']}✓ 已删除 {len(dropped)} 条{C['r']}："
          f"{C['b']}{'、'.join(dropped)}{C['r']}  {C['gry']}(注释已保留){C['r']}")
    print(f"  {C['gry']}备份：{bk}{C['r']}")
    return 0


