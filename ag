def cmd_kill(entries, args):
    """关掉跑着的 agent 窗口。

        ag kill                列出让你挑（回车取消）
        ag kill cc oc          关掉指定的
        ag kill --all          关掉整个会话
        ag kill --dead         只清理已经退出的
        ag kill -s <会话名>     指定会话
    """
    tmux = shutil.which("tmux")
    if not tmux:
        return die("没装 tmux，没有可关的会话")

    session = None
    for i, a in enumerate(args):
        if a in ("-s", "--session") and i + 1 < len(args):
            session = args[i + 1]
        elif a.startswith("--session="):
            session = a.split("=", 1)[1]

    sessions = tmux_sessions()
    # 显式点了名就先查名字 —— 免得报「没什么可关的」让人以为一切正常
    if session and session not in {x[0] for x in sessions}:
        if not sessions:
            return die(f"现在没有 tmux 会话在跑（你点名的 {session} 也不存在）")
        return die(f"没有叫 「{session}」 的 tmux 会话。"
                   f"现有的：{', '.join(x[0] for x in sessions)}")
    if not sessions:
        print(f"\n  {C['gry']}现在没有 tmux 会话在跑，没什么可关的{C['r']}\n")
        return 0

    wins = tmux_windows(session)
    known = {e.id: e for e in entries}
    kill_all = "--all" in args or "-a" in args
    dead_only = "--dead" in args or "-d" in args
    force = "--force" in args or "-f" in args
    ids = [a for a in args if not a.startswith("-")
           and a not in (session,)]

    # --all：整个会话端掉
    if kill_all:
        targets = [session] if session else sorted({x[0] for x in sessions})
        print(f"\n  {C['yel']}!{C['r']} 要关掉 {len(targets)} 个 tmux 会话："
              f"{', '.join(targets)}")
        print(f"  {C['gry']}里面的 agent 会一起没，没保存的东西就没了{C['r']}")
        if sys.stdin.isatty() and not force:
            try:
                if input(f"  确认？[y/N] ").strip().lower() not in ("y", "yes"):
                    print(f"  {C['gry']}已取消{C['r']}\n")
                    return 0
            except (EOFError, KeyboardInterrupt):
                print()
                return 0
        ok = 0
        for t in targets:
            if subprocess.run([tmux, "kill-session", "-t", t],
                              capture_output=True).returncode == 0:
                ok += 1
        print(f"  {C['grn']}✓ 关掉 {ok}/{len(targets)} 个会话{C['r']}\n")
        return 0 if ok else 1

    # 挑目标窗口
    if dead_only:
        targets = [w for w in wins if w["dead"]]
    elif ids:
        targets, missing = [], []
        for a in ids:
            e = find_entry(entries, a)
            key = e.id if e else a
            hit = [w for w in wins if w["name"] == key]
            if hit:
                targets.extend(hit)
            else:
                missing.append(a)
        if missing:
            print(f"  {C['yel']}!{C['r']} 没找到在跑的：{', '.join(missing)}")
        if not targets:
            print(f"  {C['gry']}试试 {C['cyn']}ag ps{C['r']}{C['gry']} 看现在有什么{C['r']}\n")
            return 1
    else:
        running = [w for w in wins if w["name"] in known or not w["dead"]]
        if not running:
            print(f"\n  {C['gry']}没有可关的窗口{C['r']}\n")
            return 0
        if not sys.stdin.isatty():
            print(f"\n  {C['gry']}非交互环境要指明对象："
                  f"{C['cyn']}ag kill <id...>{C['r']} 或 "
                  f"{C['cyn']}ag kill --all{C['r']}\n")
            return 1
        print(f"\n  {C['b']}现在跑着这些：{C['r']}\n")
        for i, w in enumerate(running, 1):
            e = known.get(w["name"])
            nm = e.name if e else w["cmd"]
            print(f"    {C['b']}{i:>2}{C['r']}  {C['gry']}{w['session']}:{w['index']}{C['r']}  "
                  f"{C['b']}{pad(w['name'], 14)}{C['r']} {C['gry']}{trunc(nm, 30)}{C['r']}")
        print(f"\n    {C['b']}a{C['r']}  全部")
        try:
            ans = input(f"\n  关掉哪些？（编号，逗号分隔；回车取消） ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not ans:
            print(f"  {C['gry']}已取消{C['r']}\n")
            return 0
        if ans in ("a", "all", "*"):
            targets = running
        else:
            targets = []
            for tok in ans.replace("，", ",").split(","):
                tok = tok.strip()
                if tok.isdigit() and 1 <= int(tok) <= len(running):
                    targets.append(running[int(tok) - 1])

    if not targets:
        print(f"  {C['gry']}没选中任何窗口{C['r']}\n")
        return 0

    # 别把用户正待着的那个窗口默默关掉
    my_win = current_tmux_window()
    here = [w for w in targets if my_win and w.get("wid") == my_win]
    if here and not force:
        print(f"\n  {C['yel']}!{C['r']} 你要关的 {here[0]['name']} 就是你当前这个窗口，"
              f"关掉会直接掉出去")
        if not sys.stdin.isatty() or input(f"  确认？[y/N] ").strip().lower() \
                not in ("y", "yes"):
            print(f"  {C['gry']}已取消。真要走就 {C['cyn']}ag kill "
                  f"{here[0]['name']} --force{C['r']}\n")
            return 0

    touched = {w["session"] for w in targets}
    ok, bad = [], []
    for w in targets:
        r = subprocess.run([tmux, "kill-window", "-t", _win_target(w)],
                           capture_output=True, text=True)
        (ok if r.returncode == 0 else bad).append(w["name"])
        if r.returncode != 0 and r.stderr.strip():
            print(f"    {C['red']}{trunc(r.stderr.strip(), 70)}{C['r']}")

    print(f"\n  {C['grn']}✓ 关掉 {len(ok)} 个{C['r']}"
          + (f"：{C['b']}{', '.join(ok)}{C['r']}" if ok else ""))
    if bad:
        print(f"  {C['red']}✗ {len(bad)} 个没关成：{', '.join(bad)}{C['r']}")

    # 窗口全关掉，tmux 会话自己就结束了
    left = {x[0] for x in tmux_sessions()}
    gone = [t for t in touched if t not in left]
    if gone:
        print(f"  {C['gry']}会话 {', '.join(gone)} 里没窗口了，tmux 自己也收了{C['r']}")
    print()
    return 0 if not bad else 1


# ---------------------------------------------------------------- 模糊选择器

def picker(entries, initial="", prompt="选一个 agent"):
    """全屏模糊选择器。

    返回 (entries, action)：
        entries  选中的 agent 列表。按过 Tab 多选就是多个，否则就是光标那一个
        action   "run" 普通启动 / "resume" 续聊（Ctrl-R）
    取消返回 ([], None)。
    """
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return [], None

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)

    def restore():
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1049l")   # 退出备用屏幕
        sys.stdout.write("\033[?25h")     # 显示光标
        sys.stdout.flush()

    def enter_alt():
        tty.setraw(fd)
        sys.stdout.write("\033[?1049h\033[?25l")
        sys.stdout.flush()

    def leave_alt():
        """临时回到普通屏幕跑外部命令（比如 open）。"""
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

    def read_key():
        b = os.read(fd, 1)
        if not b:
            return "EOF"
        if b == b"\x1b":
            r, _, _ = select.select([fd], [], [], 0.03)
            if not r:
                return "ESC"
            seq = os.read(fd, 1)
            if seq in (b"[", b"O"):
                while True:
                    r, _, _ = select.select([fd], [], [], 0.03)
                    if not r:
                        break
                    c = os.read(fd, 1)
                    if not c:          # 终端没了，别转圈
                        return "EOF"
                    seq += c
                    if c.isalpha() or c == b"~":
                        break
                return {b"[A": "UP", b"[B": "DOWN", b"[H": "HOME",
                        b"[F": "END", b"[5~": "PGUP", b"[6~": "PGDN"}.get(seq, "UNK")
            return "ESC"
        if b in (b"\r", b"\n"):
            return "ENTER"
        if b in (b"\x7f", b"\x08"):
            return "BACKSPACE"
        if b == b"\x03":
            return "ESC"
        if b == b"\x12":
            return "RESUME"
        if b == b"\x0f":
            return "CONFIG"
        if b == b"\t":
            return "TOGGLE"
        if b == b"\x14":
            return "PIN"
        if b == b"\x15":
            return "CLEAR"
        if b == b"\x10":
            return "UP"
        if b == b"\x0e":
            return "DOWN"
        # UTF-8 多字节
        if b[0] >= 0x80:
            need = 2 if b[0] >> 5 == 0b110 else 3 if b[0] >> 4 == 0b1110 else 4
            buf = b
            while len(buf) < need:
                r, _, _ = select.select([fd], [], [], 0.05)
                if not r:
                    break
                buf += os.read(fd, 1)
            return buf.decode("utf-8", "ignore")
        return b.decode("utf-8", "ignore")

    query = initial
    cursor = 0
    visible = [e for e in entries if not e.hidden]
    usage = load_usage()
    pins = load_pins()
    show_help = False
    flash = ""
    selected = []          # 多选，按选中的先后顺序
    W = term_width()

    idw = max([vis_len(e.id) for e in visible] + [2])
    namew = min(34, max([vis_len(e.name) for e in visible] + [4]))

    try:
        enter_alt()

        while True:
            gfilter, kw = parse_query(query)
            pool = visible
            if gfilter is not None:
                pool = [e for e in visible
                        if gfilter in (e.group or OTHER_GROUP).lower()]
            hits = order_hits(fuzzy(pool, kw), usage, pins,
                              query=kw, entries=pool)
            items = [e for e, _ in hits]

            # 空关键词时按组显示。
            #
            # 关键：items 必须跟着摊平成「显示顺序」。
            # cursor 索引的是 items，屏幕画的是 rows —— 两边顺序不一致的话，
            # 高亮打在一个地方、窗口却按另一个地方居中，按上下键就像在乱跳。
            groups = None
            rows = []
            if not kw.strip():
                groups = grouped(items, usage, pins, entries=visible)
                items = []
                for gname, es in groups:
                    rows.append(("h", gname))
                    for e in es:
                        rows.append(("i", e, len(items)))
                        items.append(e)
            else:
                rows = [("i", e, i) for i, e in enumerate(items)]
            if cursor >= len(items):
                cursor = max(0, len(items) - 1)

            W = term_width()
            H = shutil.get_terminal_size((100, 24)).lines
            list_h = max(5, H - 6)

            # 组标题也要占行，所以先摊成「显示行」，光标定位按显示行算，
            # 不然滚到后面光标会跑出可视区
            # 标题行也要占地方，先扣掉
            head_lines = sum(1 for r in rows if r[0] == "h")
            list_h = max(5, list_h - min(head_lines, 6))

            item_rows = [i for i, r in enumerate(rows) if r[0] == "i"]
            if cursor >= len(item_rows):
                cursor = max(0, len(item_rows) - 1)
            cur_row = item_rows[cursor] if item_rows else 0
            top = max(0, min(cur_row - list_h // 2, max(0, len(rows) - list_h)))
            shown = rows[top:top + list_h]
            # 首行别是孤零零一条 —— 它上面的组标题被滚掉了
            if shown and shown[0][0] == "i" and top > 0 and rows[top - 1][0] == "h":
                shown = rows[top - 1:top - 1 + list_h]
            # 末行别只剩个组标题，下面一条都没有
            while len(shown) > 1 and shown[-1][0] == "h":
                shown = shown[:-1]

            out = ["\033[H\033[2J"]
            sel_note = (f"  {C['cyn']}{C['b']}已选 {len(selected)}{C['r']}"
                        f"{C['gry']}：{','.join(selected[:4])}"
                        f"{'…' if len(selected) > 4 else ''}{C['r']}"
                        if selected else "")
            out.append(f"  {C['b']}{C['mag']}ag{C['r']} {C['dim']}Agent Gateway{C['r']}"
                       f"  {C['gry']}{len(items)}/{len(visible)} · {prompt}"
                       f" · 输入即筛选{C['r']}{sel_note}\r\n")

            if show_help:
                out.append(render_help(W))
                sys.stdout.write("".join(out))
                sys.stdout.flush()
                k = read_key()
                if k in ("ESC", "EOF", "?", "ENTER"):
                    show_help = False
                    continue
                if k in ("UP", "DOWN", "PGUP", "PGDN", "HOME", "END"):
                    continue
                if k == "BACKSPACE":
                    query = query[:-1]
                    cursor = 0
                    show_help = False
                    continue
                if k in ("CLEAR",):
                    query = ""
                    cursor = 0
                    show_help = False
                    continue
                show_help = False
                if k and k not in ("UNK",) and len(k) == 1:
                    query += k
                    cursor = 0
                elif k == "CONFIG":
                    pass
                continue

            out.append(f"  {C['cyn']}❯{C['r']} {C['b']}{query}{C['r']}"
                       f"\033[?25h\033[?25l\r\n")
            out.append(f"  {C['gry']}{'─' * min(W - 4, 96)}{C['r']}\r\n")

            if not items:
                out.append(f"\r\n  {C['yel']}没有匹配的 agent{C['r']}\r\n")

            pin_set = set(pins)
            for row in shown:
                if row[0] == "h":
                    gname = row[1]
                    rule = "─" * max(4, min(W - 8, 92) - vis_len(gname))
                    out.append(f"  {C['mag']}{C['b']}{gname}{C['r']}"
                               f" {C['gry']}{rule}{C['r']}\r\n")
                    continue
                _, e, i = row
                ok = e.resolved() is not None
                pinned = e.id in pin_set
                idc = pad(e.id, idw)
                nmc = pad(trunc(e.name, namew), namew)
                dsc = trunc(e.desc, max(10, W - idw - namew - 14))
                # 选中行与非选中行前缀完全一致，只靠反显区分，避免左右跳动
                if e.id in selected:
                    dot, dotc = "▣", C['cyn']
                elif pinned:
                    dot, dotc = "★", C['mag']
                else:
                    dot, dotc = ("●", C['grn']) if ok else ("○", C['red'])
                star = f"{C['mag']}↻{C['r']} " if e.can_resume else "  "
                if i == cursor:
                    line = (f"{C['inv']}  {dotc}{dot}{C['r']}"
                            f"{C['inv']} {C['b']}{idc}{C['r']}"
                            f"{C['inv']}  {nmc}  {C['gry']}{dsc}{C['r']}{C['inv']} {C['r']}")
                else:
                    line = (f"  {dotc}{dot}{C['r']} {C['b']}{idc}{C['r']}"
                            f"  {nmc}  {C['gry']}{dsc}{C['r']}")
                out.append(line + "\r\n")

            out.append(f"  {C['gry']}{'─' * min(W - 4, 96)}{C['r']}\r\n")

            # 详情行
            if items:
                e = items[cursor]
                bits = [f"{C['cyn']}{' '.join(e.argv())}{C['r']}"]
                stamps = usage.get(e.id) or []
                if stamps:
                    bits.append(f"{C['gry']}用过 {len(stamps)} 次 · "
                                f"{human_age(stamps[-1])}{C['r']}")
                if e.can_resume:
                    bits.append(f"{C['mag']}Ctrl-R 续聊{C['r']}")
                if e.tags:
                    bits.append(f"{C['gry']}tags: {','.join(e.tags)}{C['r']}")
                if not e.resolved() and e.install:
                    bits.append(f"{C['red']}未安装{C['r']}")
                out.append("  " + "  ".join(bits) + "\r\n")
            else:
                out.append("\r\n")

            if flash:
                out.append(f"  {C['yel']}{flash}{C['r']}\r\n")
                flash = ""
            else:
                hint = ("Enter 一次全开（各占一个窗口）" if len(selected) > 1
                        else "Tab 多选")
                out.append(f"  {C['gry']}↑↓ 移动 · {hint} · Ctrl-R 续聊 · "
                           f"Ctrl-T 置顶 · Ctrl-O 配置 · ? 帮助 · Esc 退出{C['r']}\r\n")

            sys.stdout.write("".join(out))
            sys.stdout.flush()

            k = read_key()
            if k in ("ESC", "EOF"):
                return [], None
            if k == "ENTER":
                if selected:
                    chosen = [e for e in visible if e.id in selected]
                    return chosen, "run"
                return ([items[cursor]], "run") if items else ([], None)
            if k == "TOGGLE":
                if not items:
                    continue
                e = items[cursor]
                if e.id in selected:
                    selected.remove(e.id)
                    flash = f"取消选中 {e.id}"
                else:
                    selected.append(e.id)
                    flash = f"已选 {len(selected)} 个（再按 Tab 可继续加）"
                cursor = min(len(items) - 1, cursor + 1)
            elif k == "RESUME":
                if not items:
                    continue
                e = items[cursor]
                if e.can_resume:
                    return [e], "resume"
                flash = f"{e.id} 没登记续聊方式 —— 在注册表里加 resume = [...]"
            elif k == "PIN":
                if not items:
                    continue
                e = items[cursor]
                if e.id in pins:
                    pins.remove(e.id)
                    flash = f"已取消置顶 {e.id}"
                else:
                    pins.append(e.id)
                    flash = f"已置顶 {e.id}"
                save_pins(pins)
            elif k == "CONFIG":
                if not items:
                    continue
                e = items[cursor]
                d = e.config_dir()
                if not d:
                    flash = f"没找到 {e.id} 的配置目录"
                else:
                    leave_alt()
                    opener = (["open", d] if sys.platform == "darwin"
                              else ["xdg-open", d])
                    try:
                        subprocess.run(opener, check=False,
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
                    except OSError:
                        pass
                    enter_alt()
                    flash = f"已打开 {d}"
            elif k == "?":
                show_help = True
            elif k == "UP":
                cursor = max(0, cursor - 1)
            elif k == "DOWN":
                cursor = min(len(items) - 1, cursor + 1)
            elif k == "PGUP":
                cursor = max(0, cursor - list_h)
            elif k == "PGDN":
                cursor = min(max(0, len(items) - 1), cursor + list_h)
            elif k == "HOME":
                cursor = 0
            elif k == "END":
                cursor = max(0, len(items) - 1)
            elif k == "BACKSPACE":
                query = query[:-1]
                cursor = 0
            elif k == "CLEAR":
                query = ""
                cursor = 0
            elif len(k) == 1 or (k and k not in ("UNK",)):
                query += k
                cursor = 0
    finally:
        restore()


